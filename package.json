{
  "name": "my-app",
  "type": "module",
  "scripts": {
    "predev": "npm run build:client",
    "dev": "tsx watch src/index.ts",
    "build:client": "esbuild src/client.tsx --bundle --format=esm --platform=browser --outfile=dist/assets/client.js",
    "build": "tsc && npm run build:client",
    "start": "node dist/index.js",
    "deploy:wasmer": "wasmer app deploy --owner \"$WASMER_OWNER\" --app-name \"$WASMER_APP_NAME\" --no-persist-id --build-remote"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
